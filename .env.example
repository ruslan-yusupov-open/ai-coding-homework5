# Local stdio mode needs no API key. Optional log filename, relative to the project root.
# Only filenames ending in .jsonl inside logs/ are accepted.
MCP_LOG_FILE=logs/server.jsonl

# Optional remote client: set this in the OpenCode process environment (docs/live.md).
# HOMEWORK5_MCP_TOKEN=replace-with-your-separately-issued-key
# .env is not loaded automatically. Never commit a real key.
